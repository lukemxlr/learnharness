# LearnHarness LXC systemd environment configuration
# Copy to /etc/learnharness/learnharness.env (chmod 0600, owned by root:learnharness or learnharness:learnharness)

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Bind address and port (0.0.0.0 allows LAN + Cloudflare Tunnel access on the LXC host)
HOSTNAME=0.0.0.0
PORT=3000

# Persistent data and credential paths (keep auth outside data directory)
LH_DATA_DIR=/var/lib/learnharness/data
LH_AUTH_FILE=/var/lib/learnharness/auth/auth.json

# Comma-separated allowed hostnames for LAN mDNS/DNS and Cloudflare Tunnel public domain
# IP literals (e.g. 192.168.x.x) and localhost are always permitted.
LH_ALLOWED_HOSTS=learnharness.example.com,learnharness.local

# Honor X-Forwarded-Proto and X-Forwarded-Host from Cloudflare Tunnel / local reverse proxy
LH_TRUST_PROXY=1

# Enforce single-account authentication (set up via: node scripts/user-auth.mjs init --username <name>)
LH_REQUIRE_AUTH=1
